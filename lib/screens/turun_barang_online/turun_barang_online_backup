      }
      destUrl += listLoc[i]['dest_loc_latitude'] +
          ',' +
          listLoc[i]['dest_loc_longitude'] +
          '/';
    }

    final url = 'https://www.google.com/maps/dir/${destUrl}';
    if (await canLaunch(url)) {
      await launch(url);
    } else {
      throw 'Could not launch $url';
    }
  }

